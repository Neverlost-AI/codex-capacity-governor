# PostgreSQL used by the web application.
DATABASE_URL=postgresql://capacity_governor:capacity_governor@localhost:5432/capacity_governor

# Local mode remains the default. Hosted mode requires separate, private
# environment configuration; never put real values in this file.
# CAPACITY_GOVERNOR_MODE=hosted
# CAPACITY_GOVERNOR_ORIGIN=https://private-governor.example
# CAPACITY_GOVERNOR_FOUNDER_ISSUER=https://accounts.google.com
# CAPACITY_GOVERNOR_FOUNDER_SUBJECT=<exact-google-subject>
# CAPACITY_GOVERNOR_SESSION_KEY=<at-least-32-random-characters>
# GOOGLE_CLIENT_ID=<google-oidc-client-id>
# GOOGLE_CLIENT_SECRET=<google-oidc-client-secret>
# DATABASE_URL=<supabase-transaction-pooler-postgresql-url>
# CAPACITY_GOVERNOR_POSTGRES_CA_BASE64=<base64-of-supabase-root-ca-pem>
# MIGRATION_DATABASE_URL=<direct-supabase-postgresql-url-for-controlled-job-only>
